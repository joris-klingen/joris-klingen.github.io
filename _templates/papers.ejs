<%
// Renders papers from data/papers.yml (generated in the research hub; do not edit that file here).
// Keep HTML lines unindented: Quarto reads the output as Markdown, where 4-space indents become code.
// The abstract toggle is a hidden checkbox + label (no JavaScript): see .abs-toggle in styles.scss.
function names(list) {
  if (!list || list.length === 0) return "";
  if (list.length === 1) return list[0];
  return list.slice(0, -1).join(", ") + " and " + list[list.length - 1];
}
%>
<% for (const p of items) { const l = p.links || {}; const hasCo = p.coauthors && p.coauthors.length; %>
<article class="paper <%= p.status %>">
<% if (p.abstract) { %><input type="checkbox" class="abs-toggle" id="abs-<%= p.id %>"><% } %>
<h3 class="paper-title"><%= p.title %></h3>
<p class="paper-meta"><% if (hasCo) { %><span>with <%= names(p.coauthors) %></span><% } %><% if (p.journal) { %><span><span class="venue"><%= p.journal %></span><% if (p.year && p.status !== "wip") { %>, <%= p.year %><% } %></span><% } %><% if (p.abstract) { %><label class="act abs-label" for="abs-<%= p.id %>">Abstract</label><% } %><% if (l.doi) { %><a class="act" href="https://doi.org/<%= l.doi %>">DOI</a><% } %><% if (l.pdf) { %><a class="act" href="<%= l.pdf %>">Paper</a><% } %><% if (l.url) { %><a class="act" href="<%= l.url %>">Read</a><% } %><% if (l.code) { %><a class="act" href="<%= l.code %>">Code</a><% } %><% if (l.page) { %><a class="act" href="<%= l.page %>">Replication &amp; extension</a><% } %></p>
<% if (p.summary) { %><p class="paper-summary"><%= p.summary %></p><% } %>
<% if (p.abstract) { %><p class="paper-abstract"><%= p.abstract %></p><% } %>
</article>
<% } %>
